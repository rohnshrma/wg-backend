# ============================================================
# WEBIGEEKS BACKEND — ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# Server
NODE_ENV=development
PORT=5001

# ⚠️ REQUIRED: MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/webigeeks?retryWrites=true&w=majority

# JWT (change the secret to a long random string in production)
JWT_SECRET=webigeeks-super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Cloudinary (optional — for image uploads)
# Get from: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email — Gmail SMTP
# Use an App Password (not your main password):
# Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=webigeeksofficial@gmail.com
SMTP_PASS=your_gmail_app_password_here
EMAIL_FROM=WebiGeeks <webigeeksofficial@gmail.com>
FROM_NAME=WebiGeeks
FROM_EMAIL=webigeeksofficial@gmail.com

# Razorpay (optional — for UPI AutoPay e-mandate installment collection)
# Get from: https://dashboard.razorpay.com → Settings → API Keys (use Test Mode keys here)
# Requires the Subscriptions product enabled on the account — confirm in the
# dashboard before generating keys, since enabling it may require business KYC.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings → Webhooks → create a webhook pointing at /api/webhooks/razorpay, copy its secret here
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API (optional — for WhatsApp notifications)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ADMIN_PHONE=918766367815
ADMIN_WHATSAPP=918766367815

# Site URLs
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Contact
CONTACT_PHONE=+91 8766367815
CONTACT_EMAIL=webigeeksofficial@gmail.com

# Admin defaults
ADMIN_EMAIL=webigeeksofficial@gmail.com
ADMIN_DEFAULT_PASSWORD=Admin@123
